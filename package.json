{
  "name": "diff-punk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-test.mjs",
    "test:dev": "node scripts/dev-test.mjs",
    "test:dom": "node scripts/dom-test.mjs",
    "test:cli": "node scripts/cli-test.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "playwright": "^1.56.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
